{
  "version": 1,
  "description": "Independent shared Rust/TypeScript SQL DTO cases. Expand literal directly, or prefix + unit repeated repeat times + suffix. Cases test new SQL DTOs only. Canonical blank = every scalar is Unicode White_Space or U+FEFF; empty is blank.",
  "blank": [
    { "text": "", "expectedBlank": true },
    { "text": " \t\r\n", "expectedBlank": true },
    { "text": "\u0085", "expectedBlank": true },
    { "text": "\ufeff", "expectedBlank": true },
    { "text": "\u00a0\u2003\u2028\u3000\ufeff", "expectedBlank": true },
    { "text": "\u200b", "expectedBlank": false },
    { "text": "\u0085x\ufeff", "expectedBlank": false },
    { "text": "😀", "expectedBlank": false }
  ],
  "aliases": [
    { "literal": "table", "expectedValid": true },
    { "literal": "SELECT", "expectedValid": true },
    { "literal": "주문 자료", "expectedValid": true },
    { "literal": "", "expectedValid": false },
    { "literal": " \t\u0085\ufeff", "expectedValid": false },
    { "literal": "a\u0000b", "expectedValid": false },
    { "unit": "a", "repeat": 128, "expectedValid": true },
    { "unit": "a", "repeat": 129, "expectedValid": false },
    { "unit": "한", "repeat": 128, "expectedValid": true },
    { "unit": "😀", "repeat": 128, "expectedValid": true },
    { "unit": "😀", "repeat": 129, "expectedValid": false },
    { "unit": "é", "repeat": 64, "expectedValid": true },
    { "unit": "é", "repeat": 65, "expectedValid": false }
  ],
  "aliasPairs": [
    { "values": ["orders", "orders_2"], "expectedValid": true },
    { "values": ["orders", "ORDERS"], "expectedValid": false },
    { "values": ["Ä", "ä"], "expectedValid": true },
    { "values": ["동일", "동일"], "expectedValid": false }
  ],
  "identities": [
    { "literal": "run-1", "expectedValid": true },
    { "literal": "", "expectedValid": false },
    { "literal": "\u0085", "expectedValid": false },
    { "literal": "\ufeff", "expectedValid": false },
    { "literal": "a\u0000b", "expectedValid": false },
    { "unit": "a", "repeat": 128, "expectedValid": true },
    { "unit": "a", "repeat": 129, "expectedValid": false },
    { "unit": "😀", "repeat": 32, "expectedValid": true },
    { "unit": "😀", "repeat": 33, "expectedValid": false }
  ],
  "sqlText": [
    { "literal": "SELECT 1", "expectedValid": true },
    { "literal": "", "expectedValid": false },
    { "literal": " \t\u0085\ufeff", "expectedValid": false },
    { "literal": "SELECT '\u0000'", "expectedValid": false },
    { "prefix": "SELECT '", "unit": "x", "repeat": 65527, "suffix": "'", "expectedValid": true },
    { "prefix": "SELECT '", "unit": "x", "repeat": 65528, "suffix": "'", "expectedValid": false },
    { "prefix": "SELECT '", "unit": "한", "repeat": 21842, "suffix": "'", "expectedValid": true },
    { "prefix": "SELECT '", "unit": "한", "repeat": 21843, "suffix": "'", "expectedValid": false },
    { "prefix": "SELECT '", "unit": "😀", "repeat": 16381, "suffix": "'", "expectedValid": true },
    { "prefix": "SELECT '", "unit": "😀", "repeat": 16382, "suffix": "'", "expectedValid": false }
  ],
  "sourceCounts": [
    { "value": 0, "expectedValid": false },
    { "value": 1, "expectedValid": true },
    { "value": 32, "expectedValid": true },
    { "value": 33, "expectedValid": false }
  ],
  "pageOffsets": [
    { "value": 0, "expectedValid": true },
    { "value": 999999, "expectedValid": true },
    { "value": 1000000, "expectedValid": true },
    { "value": 1000001, "expectedValid": false },
    { "value": 9007199254740991, "expectedValid": false }
  ],
  "pageLimits": [
    { "value": 0, "expectedValid": false },
    { "value": 1, "expectedValid": true },
    { "value": 200, "expectedValid": true },
    { "value": 201, "expectedValid": false }
  ],
  "projections": [
    { "columns": [], "expectedValid": false },
    { "columns": ["r0"], "expectedValid": true },
    { "columns": ["r4095"], "expectedValid": true },
    { "columns": ["r4096"], "expectedValid": false },
    { "columns": ["r0", "r1"], "expectedValid": true },
    { "columns": ["r0", "r0"], "expectedValid": false },
    { "columns": ["r01"], "expectedValid": false },
    { "columns": ["r+1"], "expectedValid": false },
    { "columns": ["r-1"], "expectedValid": false },
    { "columns": ["r1.0"], "expectedValid": false },
    { "columns": ["R1"], "expectedValid": false }
  ],
  "projectionCounts": [
    { "value": 1, "expectedValid": true },
    { "value": 64, "expectedValid": true },
    { "value": 65, "expectedValid": false }
  ]
}
