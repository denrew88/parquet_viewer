# Local UI validation captures and intermediate evidence
# Keep generated test screenshots local; application icons and docs assets are unaffected.
artifacts/**/*.png
artifacts/**/*.jpg
artifacts/**/*.jpeg
artifacts/**/*.webp
# Generated test results, geometry captures, and intermediate build records stay local.
artifacts/**/*.json
